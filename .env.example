# Canonical production origin (no trailing slash). Single source of truth for
# canonical tags, JSON-LD, and the sitemap. Defaults to the production domain
# in code, so this only needs setting for preview/staging environments.
NEXT_PUBLIC_SITE_URL=https://www.concreteprosdallas.com

# Supabase Postgres connection string.
# Copy this file to `.env` and replace [YOUR-PASSWORD] with your database password.
# For serverless/Vercel deployments, prefer the Supabase connection pooler
# (port 6543) over the direct connection (port 5432) to avoid exhausting connections.
DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.tsybcnnjylmvhsxzknug.supabase.co:5432/postgres
